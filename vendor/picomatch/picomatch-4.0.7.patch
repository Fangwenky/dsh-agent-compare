+// Require a uniquely decodable body before adding a repetition. Each branch
+// is a nonempty literal and no branch can consume a prefix of another.
+// Fold case even if the caller applies case-insensitive flags downstream.
+const hasUnambiguousLiteralBranches = body => {
+  const branches = body.split('|');
+  if (branches.some(branch => !branch.length || /[^A-Za-z0-9_.-]/.test(branch))) {
+    return false;
+  }
+  const sorted = branches.map(branch => branch.toLowerCase()).sort();
+  return sorted.every((branch, index) => index === 0 || !branch.startsWith(sorted[index - 1]));
